{
  "run_name": "mbert_agentdojo_turkish_seed_101_v0.1.0",
  "model_name": "google-bert/bert-base-multilingual-cased",
  "task_type": "binary_sequence_classification",
  "num_labels": 2,
  "label_mapping": {
    "0": "contextually_safe",
    "1": "contextually_risky"
  },
  "data": {
    "corpus_release": "agentdojo_turkish_corpus_v0.3.0",
    "train_path": "data/processed/agentdojo_turkish_corpus_v0.3.0/agentdojo_turkish_corpus_v0.3.0_train.jsonl",
    "validation_path": "data/processed/agentdojo_turkish_corpus_v0.3.0/agentdojo_turkish_corpus_v0.3.0_validation.jsonl",
    "text_field": "text",
    "label_field": "general_risk_label",
    "pair_id_field": "pair_id",
    "group_id_field": "session_group_id",
    "train_rows": 134,
    "validation_rows": 30
  },
  "tokenization": {
    "max_length": 512,
    "padding": "max_length",
    "truncation": true
  },
  "training": {
    "seed": 101,
    "learning_rate": 2e-05,
    "weight_decay": 0.01,
    "num_train_epochs": 5,
    "per_device_train_batch_size": 4,
    "per_device_eval_batch_size": 8,
    "gradient_accumulation_steps": 4,
    "warmup_ratio": 0.1,
    "lr_scheduler_type": "linear",
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "logging_strategy": "steps",
    "logging_steps": 5,
    "load_best_model_at_end": true,
    "metric_for_best_model": "f1",
    "greater_is_better": true,
    "save_total_limit": 2,
    "fp16": false,
    "bf16": false
  },
  "evaluation": {
    "primary_metric": "f1",
    "metrics": [
      "accuracy",
      "precision",
      "recall",
      "f1",
      "roc_auc",
      "confusion_matrix"
    ],
    "risk_score_definition": "P(label=1)"
  },
  "output": {
    "run_dir": "artifacts/training_runs/mbert_agentdojo_turkish_seed_101_v0.1.0",
    "report_dir": "artifacts/training_reports/mbert_agentdojo_turkish_multiseed_v0.1.0/seed_101"
  }
}
